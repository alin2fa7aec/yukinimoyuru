# ~/.bashrc

# --- safety -------------------------------------------------------------

# Only for interactive shells
[[ $- != *i* ]] && return

# --- ble.sh (load early, attach at the end) -----------------------------

# Load ble.sh at the top with --noattach and run ble-attach at the end.
# Do nothing if it is already loaded, e.g. by NixOS's programs.bash.blesh.
if [[ -z ${BLE_VERSION-} ]]; then
  for __blesh in \
    /opt/blesh/share/blesh/ble.sh \
    "$HOME/.local/share/blesh/ble.sh"; do
    if [[ -f $__blesh ]]; then
      source "$__blesh" --noattach
      break
    fi
  done
  unset __blesh
fi

# Prevent accidental file overwrite with redirection (override with >|)
set -o noclobber

# --- history ------------------------------------------------------------

shopt -s histappend
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups

# Save the exit status of the previous command.
# Later commands in PROMPT_COMMAND overwrite $?, so this must come first.
PROMPT_COMMAND='__st=$?'

if [[ ${BLE_VERSION-} ]]; then
  # Leave saving history and sharing it across sessions to ble.sh
  bleopt history_share=on
else
  # Without ble.sh, only save immediately (history from other sessions is not pulled in)
  PROMPT_COMMAND+='; history -a'
fi

# --- locale -------------------------------------------------------------

export LANG=C.UTF-8
unset LC_ALL

# --- mise ---------------------------------------------------------------

# Use CLI tools installed with mise through their shims.
# This file is also mounted into the tools/diva container, which has no mise, so add the shims only when they exist.
# Avoid stacking duplicates onto PATH in nested shells.
__mise_shims="$HOME/.local/share/mise/shims"
if [[ -d $__mise_shims && ":$PATH:" != *":$__mise_shims:"* ]]; then
  export PATH="$__mise_shims:$PATH"
fi
unset __mise_shims

# --- prompt -------------------------------------------------------------

# Colors
CLR_RESET="\[\e[0m\]"
CLR_RED="\[\e[31m\]"
CLR_GREEN="\[\e[32m\]"
CLR_YELLOW="\[\e[33m\]"
CLR_BLUE="\[\e[34m\]"
CLR_MAGENTA="\[\e[35m\]"
CLR_CYAN="\[\e[36m\]"

# root or user
if [[ $EUID -eq 0 ]]; then
  USER_CLR="$CLR_RED"
else
  USER_CLR="$CLR_GREEN"
fi

# Distro / container marker
# Put the original glyph (Nerd Font) here
DISTRO_ICON=''
CONTAINER_ICON='[ctr]'

if [[ -f /.dockerenv || -f /run/.containerenv || -n ${container-} ]]; then
  ENV_TAG="${CLR_CYAN}${CONTAINER_ICON}${CLR_RESET}"
else
  ENV_TAG="${CLR_MAGENTA}${DISTRO_ICON}${CLR_RESET}"
fi

# git branch (lightweight)
# Outside a repository both fail and nothing is shown.
# Put the original branch glyph into GIT_ICON
GIT_ICON=''
__git_branch() {
  local branch
  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null ||
           git describe --tags --always 2>/dev/null) || return
  printf ' [%s%s]' "$GIT_ICON" "$branch"
}

# last exit status (non-zero only)
__exit_status() {
  (( __st != 0 )) && printf ' %d' "$__st"
}

# prompt main
# \\\$ becomes \$ after assignment and shows # for root when the prompt is expanded
PS1="${ENV_TAG} ${CLR_BLUE}\w${CLR_RESET}\
${CLR_YELLOW}\$(__git_branch)${CLR_RESET}\
${CLR_RED}\$(__exit_status)${CLR_RESET} ${USER_CLR}\\\$${CLR_RESET} "

# --- aliases ------------------------------------------------------------

if command -v eza > /dev/null 2>&1; then
  alias ls='eza --icons --git --group-directories-first'
  alias ll='eza --icons --git --group-directories-first -lbhF'
  alias la='eza --icons --git --group-directories-first -labhF'
  alias lt='eza --tree --icons --group-directories-first --level=2'
else
  alias ls='ls --color=auto --group-directories-first'
  alias ll='ls -lhF'
  alias la='ls -lAhF'
fi

alias ..='cd ..'
alias ...='cd ../..'

alias grep='grep --color=auto'
alias df='df -h'
alias du='du -h'

# safer rm/mv/cp
alias rm='rm -i'
alias mv='mv -i'
alias cp='cp -i'

# --- pager --------------------------------------------------------------

export PAGER=less
export LESS='-R -F -X'
export LESSHISTFILE='-'

# --- completion ---------------------------------------------------------

# Do nothing if the system side (/etc/bash.bashrc on Debian-based systems or /etc/bashrc on NixOS) already loaded it
if [[ -z ${BASH_COMPLETION_VERSINFO-} ]]; then
  for __bc in \
    /usr/share/bash-completion/bash_completion \
    /etc/bash_completion; do
    if [[ -f $__bc ]]; then
      source "$__bc"
      break
    fi
  done
  unset __bc
fi

# --- shell tools --------------------------------------------------------

if command -v fzf > /dev/null 2>&1; then
  if [[ ${BLE_VERSION-} ]]; then
    # With ble.sh, use ble.sh's integration
    ble-import -d integration/fzf-completion
    ble-import -d integration/fzf-key-bindings
  else
    eval "$(fzf --bash)"
  fi
fi

if command -v zoxide > /dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

# Jump to the directory yazi was left in
if command -v yazi > /dev/null 2>&1; then
  yz() {
    local tmp cwd
    tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    command yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [[ -n "$cwd" && "$cwd" != "$PWD" ]] && builtin cd -- "$cwd"
    command rm -f -- "$tmp"
  }
fi

# --- misc ---------------------------------------------------------------

# keep bash responsive
unset MAILCHECK

# --- ble.sh attach (must be last) ---------------------------------------

[[ ${BLE_VERSION-} ]] && ble-attach
