# nordfox (nightfox.nvim) colors, matching the waybar and wezterm themes.
# Colors are written as RRGGBB[AA]

# The background is the same wallpaper as swaybg (swaybg in home/alin.nix). Monitors without an image are filled with color
image=DP-3:~/Pictures/wallpaper/DP-3
image=HDMI-A-1:~/Pictures/wallpaper/HDMI-A-1
scaling=fill
color=232831

font=Moralerspace Argon HW
font-size=20
indicator-radius=90
indicator-thickness=8
show-failed-attempts
indicator-caps-lock
ignore-empty-password

# Idle. The inside of the ring is translucent bg1 and the ring is fg3
inside-color=2e3440cc
ring-color=7e8188
line-color=00000000
separator-color=00000000
text-color=cdcecf
# Typed keys show on the ring in cyan, deleted keys in orange
key-hl-color=88c0d0
bs-hl-color=c9826b
# blue while verifying
inside-ver-color=2e3440cc
ring-ver-color=81a1c1
text-ver-color=81a1c1
# red when wrong
inside-wrong-color=2e3440cc
ring-wrong-color=bf616a
text-wrong-color=bf616a
# fg3 when everything is cleared
inside-clear-color=2e3440cc
ring-clear-color=7e8188
text-clear-color=cdcecf
# yellow when Caps Lock is on
caps-lock-key-hl-color=ebcb8b
caps-lock-bs-hl-color=c9826b
ring-caps-lock-color=ebcb8b
text-caps-lock-color=ebcb8b
inside-caps-lock-color=2e3440cc
