{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/**)",
      "Edit(**/.git/hooks/**)",
      "Edit(**/.git/config)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "crates.io",
        "index.crates.io",
        "static.crates.io"
      ]
    }
  },
  "allowManagedHooksOnly": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "strictKnownMarketplaces": [
    { "source": "github", "repo": "InterfaceX-co-jp/genshijin" },
    { "source": "github", "repo": "nanaism/yomiyasu" }
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "nu", "args": ["-c", "print ({terminalSequence: (char -i 7)} | to json -r)"] }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "nu", "args": ["-c", "print ({terminalSequence: (char -i 7)} | to json -r)"] }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "nu", "args": ["-c", "print ({terminalSequence: (char -i 7)} | to json -r)"] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "nu", "args": ["--stdin", "~/.claude/writing-lint.nu", "hook"] }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [
          { "type": "command", "command": "nu", "args": ["-c", "print ({terminalSequence: (char -i 7)} | to json -r)"] }
        ]
      }
    ]
  }
}
