;; require kanata v1.11.0
;;
;; Linux (NixOS / KDE Plasma) 用 kanata スクリプトファイル
;;
;; note: Output is interpreted by the OS keyboard layout, so symbol aliases are written with JIS layout key codes.
;;       Set the OS layout to Japanese (jp).
;; note: On NixOS, pass this file via services.kanata.keyboards.<name>.configFile (not the config option, since it contains defcfg).

(defcfg
  ;; defsrc is empty and keys are mapped with deflayermap, so also process keys not in defsrc
  process-unmapped-keys yes
)

;; ---- Codes for JIS-specific keys (evdev key codes: linux/input-event-codes.h) ----
(deflocalkeys-linux
  yen 124        ;; KEY_YEN
  ro  89         ;; KEY_RO
  katakana  93   ;; KEY_KATAKANAHIRAGANA
)

(defsrc)

;; ============================================================
;; Aliases
;; ============================================================
(defalias
  ;; ---- Layer switching ----
  mh (tap-hold-press 200 200 muhenkan (layer-while-held muhenkan-layer))
  hk (tap-hold-press 200 200 henkan (layer-while-held henkan-layer))

  ;; ---- leader ----
  ;; Tap to add Meta to the next key pressed (to type niri's Mod+key without holding Mod).
  ;; It ends when the next key is released, so holding Shift while pressing the next key gives Mod+Shift+key.
  ;; Cancelled if no key is pressed within 2 seconds.
  ldr (one-shot-release 2000 lmet)

  ;; ---- Henkan layer: symbols (fork branches on Shift) ----
  ;; note: all based on the JIS layout
  ;;
  ;;  Key    Normal  Shift
  ;;  j      (       )
  ;;  k      {       }
  ;;  l      [       ]
  ;;  i      ~       %
  ;;  m      _       |
  ;;  n      $       &
  ;;  o      "       `
  ;;  u      !       @
  ;;  ,      *       +
  ;;  .      :       ;
  h-j    (fork S-8 S-9 (lsft rsft))
  h-k    (fork S-rbrc S-\ (lsft rsft))
  h-l    (fork (unshift rbrc) (unshift \) (lsft rsft))
  h-i    (fork S-eql 5 (lsft rsft))
  h-m    (fork S-ro yen (lsft rsft))
  h-n    (fork S-4 6 (lsft rsft))
  h-o    (fork S-2 S-lbrc (lsft rsft))
  h-u    (fork S-1 (unshift lbrc) (lsft rsft))
  h-comm (fork S-' S-; (lsft rsft))
  h-dot  (fork ' (unshift ;) (lsft rsft))

  ;; ---- Muhenkan layer ----
  ;; Backspace / Shift: Delete
  m-d (fork bspc (unshift del) (lsft rsft))
  ;; Shift+Enter / Shift: Alt+Enter
  m-f (fork S-Enter (unmod lalt enter) (lsft rsft))
  ;; Select line: Home -> Shift+End
  m-r (macro home 5 S-end)
  ;; Select word: Ctrl+Left -> Ctrl+Shift+Right
  m-e (macro C-left 5 C-S-rght)
  ;; Ctrl+Shift+\
  edit-w C-S-yen
  ;; Meta+V (クリップボード履歴。KDE Plasma では Klipper、niri では cliphist を fuzzel で選ぶ)
  clip M-v
)

;; ============================================================
;; Base layer
;; ============================================================
(deflayermap (base)
  ;; Caps Lock (the Eisu key on JIS) -> left Ctrl
  caps      lctl
  ;; Muhenkan -> hold to activate the layer
  muhenkan  @mh
  ;; Henkan -> hold to activate the layer
  henkan    @hk
  ;; Katakana/Hiragana -> JIS: min = - / Shift+min = =
  katakana  min
  ;; Hankaku/Zenkaku (KEY_GRAVE on JIS), R Alt -> leader
  grv       @ldr
  ralt      @ldr
)

;; ============================================================
;; Muhenkan layer (while Muhenkan is held)
;; ============================================================
;; Shift passes through: sending arrow keys while physical Shift is held makes a selection
(deflayermap (muhenkan-layer)
  ;; Navigation (Shift passes through)
  j    left
  k    down
  l    rght
  i    up
  u    home          ;; line start
  m    end           ;; line end
  o    pgup
  .    pgdn

  ;; Editing
  f    @m-f           ;; Shift+Enter / Shift: Alt+Enter
  d    @m-d           ;; Backspace / Shift: Delete
  q    esc
  r    @m-r           ;; select line
  e    @m-e           ;; select word
  w    @edit-w        ;; Ctrl+Shift+\

  ;; Other
  v    @clip          ;; clipboard history
  spc  mlft           ;; left click
)

;; ============================================================
;; Henkan layer (while Henkan is held)
;; ============================================================
(deflayermap (henkan-layer)
  j    @h-j           ;; ( / )
  k    @h-k           ;; { / }
  l    @h-l           ;; [ / ]
  i    @h-i           ;; ~ / %
  m    @h-m           ;; _ / |
  n    @h-n           ;; $ / &
  o    @h-o           ;; " / `
  u    @h-u           ;; ! / @
  ,    @h-comm        ;; * / +
  .    @h-dot         ;; : / ;
  h    S-3            ;; #
  p    S-7            ;; '
  y    eql            ;; ^

  f    0
  d    1
  s    2
  a    3
  r    4
  e    5
  w    6
  c    7
  x    8
  z    9

  spc  mrgt           ;; right click
)
