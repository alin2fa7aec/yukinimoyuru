// Per-module settings included from each bar in config.jsonc
{
  // Click to toggle niri's overview, for rearranging windows with the mouse alone
  "custom/overview": {
    "format": "󱒆",
    "tooltip-format": "オーバービュー",
    "on-click": "niri msg action toggle-overview"
  },
  // Icons come from Symbols Nerd Font (set in style.css).
  // style.css makes modules square boxes, so stack the icon and number vertically to fit
  "cpu": {
    "format": "\n{usage}",
    "interval": 5
  },
  "memory": {
    "format": "\n{percentage}",
    "interval": 5,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },
  "idle_inhibitor": {
    // activated means sleep is being inhibited
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊"
    },
    "tooltip-format-activated": "Keeping the screen awake",
    "tooltip-format-deactivated": "Screen sleeps as usual"
  },
  "clock": {
    // 時刻は QHD の壁時計 (config.jsonc の wallclock) に任せ、こちらはカレンダーの入り口として年と日付だけを出す
    "format": "{:%Y\n%m/%d}",
    // The system LC_TIME is ja_JP, so use en_US for the clock alone to get English weekday and month names in the calendar
    "locale": "en_US.UTF-8",
    // Hover to show this month's calendar, with today in blue.
    // While hovering, scroll to change months, right-click to toggle month/year view, middle-click to return to this month
    "tooltip-format": "<tt>{calendar}</tt>",
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-right": "mode",
      "on-click-middle": "shift_reset"
    },
    "calendar": {
      "mode-mon-col": 3,
      "format": {
        "today": "<span color='#81a1c1'><b>{}</b></span>"
      }
    }
  },
  "pulseaudio": {
    "format": "󰕾\n{volume}",
    "format-muted": "󰖁",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  // The swaync notification center. Stacks the icon and the unread count vertically.
  // Click to toggle the panel; right-click to toggle Do Not Disturb
  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "escape": true,
    "format": "{icon}\n{text}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󱅫",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "tray": {
    "spacing": 8
  }
}
